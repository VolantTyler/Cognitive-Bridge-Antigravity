# GEMINI_API_KEY: Optional. Only required for running the offline psychometric evaluation tests (scripts/agent_eval.py).
# The main application uses Vertex AI via Firebase Cloud Functions.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional overrides for the psychometric eval model fallback chain
# (default: gemini-3.8-flash → gemini-2.5-flash → gemini-2.5-pro → gemini-1.5-flash).
# GEMINI_EVAL_MODEL="gemini-3.8-flash"
# GEMINI_EVAL_FALLBACK_MODELS="gemini-2.5-flash,gemini-1.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIREBASE_FIRESTORE_DATABASE_ID"
